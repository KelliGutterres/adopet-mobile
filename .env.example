# URL da API (sem barra no final). Fallback quando não há Metro (simulador / emulador).
# Simulador iOS / Expo no PC:        http://127.0.0.1:3000
# Emulador Android:                  http://10.0.2.2:3000
# Expo Go (túnel ou LAN): o app usa o host do Metro; metro.config.js encaminha à API local.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Wi-Fi de campus: `npm run start:tunnel` + EXPO_UNSTABLE_TUNNEL_V2=1
# EXPO_UNSTABLE_TUNNEL_V2=1

# Obrigatório no SDK 57: expo/fetch não envia arquivo local no multipart.
# Sem isso, POST /animais/:id/imagem e /animais/comparar falham com “API fora do ar”.
EXPO_PUBLIC_USE_RN_FETCH=1
